# --- Ollama ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.6:latest
# Model used by Alfred (the dashboard assistant). For a MUCH faster Alfred, point
# this at a smaller/faster model than the 36B default — e.g. a 7-8B local model,
# a cloud model, or a vision model (e.g. qwen2-vl / llava) if you want Alfred to
# actually SEE the images you attach. Alfred uses a small 4k context for speed.
OLLAMA_CHAT_MODEL=qwen3.6:latest
# Keep the model resident between agent runs (avoids 23s reload each time)
OLLAMA_KEEP_ALIVE=30m
# Context window. qwen3.6 handles large contexts; lower this if you are RAM-bound.
OLLAMA_NUM_CTX=32768

# --- Control plane ---
PORT=7878

# --- ISL platform (auth + multi-project) ---
# The seeded administrator. First sign-in with this email sets the password.
ADMIN_EMAIL=admin@example.com
# Session cookie secret — CHANGE THIS in production.
AUTH_SECRET=isl-dev-secret-change-me
# Session lifetime in hours.
SESSION_TTL_HOURS=168
# Il primo progetto che ISL governa. Lascia vuoto il nome per derivarlo dalla cartella.
# DEFAULT_PROJECT_PATH deve puntare al codice da migliorare: senza, ISL parte su se stesso.
DEFAULT_PROJECT_NAME=
DEFAULT_PROJECT_PATH=

# --- Autonomy ---
# Seconds between orchestrator ticks. 0 disables the automatic loop (manual runs only).
LOOP_INTERVAL_SECONDS=900
# Start the loop automatically on boot
AUTOSTART_LOOP=false
# branch = commit approved changes on a dedicated branch (safe, default)
# direct = write approved changes straight into the working tree, no commit
APPLY_MODE=branch
# Hard cap on how many pending (unreviewed) proposals may exist before agents pause
MAX_PENDING_PROPOSALS=20

# --- Autonomous iteration engine (hybrid) ---
# Runs the full catalog→research→plan→implement→review→security→regression→test→finalize
# pipeline in a sandbox worktree. Passing iterations auto-commit to WORK_BRANCH;
# nothing reaches main without an explicit promotion from the Deploy tab.
WORK_BRANCH=agents/auto-improve
# Seconds between iterations when the loop is running
ITERATION_INTERVAL_SECONDS=120
# Start the iteration loop automatically on boot
ITERATION_AUTOSTART=false
# Hard daily cap on iterations
MAX_ITERATIONS_PER_DAY=50

# Identita' con cui gli agenti firmano i commit dentro il progetto governato.
# Cambiandola cambia anche cio' che le metriche DORA riconoscono come deployment:
# il riconoscitore in src/deploy/dora.js e' costruito da questi valori, non fisso.
ISL_GIT_AUTHOR_NAME=ISL Agents
ISL_GIT_AUTHOR_EMAIL=agents@isl.local
