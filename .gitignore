node_modules/
.data/
.env
dashboard/dist/
tools/pdf/.chrome-profile/
tools/pdf/ISL.html

# Clone vuoto del repository creato dentro il progetto stesso: contiene solo un .git
# senza commit, e git interrompe l'intero `add` quando lo incontra ("does not have a
# commit checked out"). Escluso, non cancellato: se serviva, e' ancora li'.
ISL---improvment-software-loop/

# Artefatti locali e scarti di strumenti
.isl-cleanup/
*.log
nul
.DS_Store
Thumbs.db

# Segreti e dati locali — NON pubblicare.
# `New Text Document.txt` contiene la coppia email+password dell'amministratore ISL
# in chiaro: su un repo pubblico equivale a consegnare il piano di controllo.
New Text Document.txt

# Database SQLite finiti nella radice invece che sotto .data/ (un percorso relativo
# aperto dalla cartella sbagliata). Sono database di progetto a tutti gli effetti.
/default
/isl-self
*.db
*.sqlite
*.sqlite3

# Stato locale della macchina: impostazioni, cronologia di sessione, percorsi utente.
.claude/settings.local.json
.remember/

# Script di debug estemporanei
_t*.mjs

# Diario interno dei miglioramenti: era escluso perche' il post-mortem di un
# disservizio nominava i servizi, la topologia e il conteggio delle rotte di un
# prodotto privato. Ora e' anonimizzato — nome del prodotto, servizi, componenti e
# modelli sostituiti da descrizioni funzionali, metriche di scala rimosse — quindi
# viene pubblicato: le lezioni tecniche restano integrali, l'architettura privata
# non e' piu' ricostruibile.

# Strumento one-off legato a un singolo prodotto: cabla una sua pagina e ne contiene
# il catalogo di stringhe UI in quattro lingue. Non appartiene a un ISL generico.
# Resta sul disco, fuori dal versionamento.
tools/i18nLister.mjs
